# Bootloader for JIJIEFPVH743

MCU STM32H7xx STM32H743xx

define AP_HW_JIJIEFPVH743 1043
APJ_BOARD_ID AP_HW_JIJIEFPVH743

OSCILLATOR_HZ 8000000
MCU_CLOCKRATE_MHZ 480

FLASH_SIZE_KB 2048

# Bootloader takes the first 128 kB
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# LED (optional)
PD10 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0
